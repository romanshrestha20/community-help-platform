generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserModel {
  id           String  @id @default(uuid())
  email        String  @unique
  phone        String? @unique
  passwordHash String?
  isVerified   Boolean @default(false)

  profile Profile?

  requests         HelpRequest[] @relation("UserRequests")
  bids             Bid[]         @relation("UserBids")
  assignedRequests HelpRequest[] @relation("AssignedRequests")

  sentMessages  Message[]            @relation("SentMessages")
  conversations ConversationMember[]

  receivedReviews Review[] @relation("UserReviewsReceived")

  notifications Notification[]
  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]

  reviews       Review[]
  reviewReplies ReviewReply[]
  reviewLikes   ReviewLike[]
  favorites     Favorite[]
  images        Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model OAuthAccount {
  id         String       @id @default(uuid())
  provider   AuthProvider
  providerId String

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  bio         String?
  dateOfBirth DateTime?
  gender      Gender?
  userType    UserType  @default(GENERAL)
  rating      Float     @default(0)
  helpCount   Int       @default(0)

  avatarUrl      String?
  avatarPublicId String?

  searchRadiusMeters Int? @default(800)

  user      UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressId String?   @unique
  address   Location? @relation("ProfileAddress", fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id               String   @id @default(uuid())
  latitude         Float
  longitude        Float
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  formattedAddress String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  helpRequest HelpRequest? @relation("HelpRequestLocation")
  profile     Profile?     @relation("ProfileAddress")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  createdAt DateTime @default(now())
  expiresAt DateTime
}

model HelpRequest {
  id          String    @id @default(uuid())
  requesterId String
  requester   UserModel @relation("UserRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  title       String
  description String
  category    String

  locationId String?   @unique
  location   Location? @relation("HelpRequestLocation", fields: [locationId], references: [id], onDelete: SetNull)

  serviceRadiusMeters Int? @default(800)

  budget Float?
  isPaid Boolean       @default(false)
  status RequestStatus @default(OPEN)

  bids             Bid[]
  assignedHelperId String?
  assignedHelper   UserModel? @relation("AssignedRequests", fields: [assignedHelperId], references: [id], onDelete: SetNull)

  conversation Conversation?
  images       Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String      @id @default(uuid())
  requestId String      @unique
  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  members  ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
}

model ConversationMember {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         UserModel    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_members")
}

model Bid {
  id String @id @default(uuid())

  helperId String
  helper   UserModel @relation("UserBids", fields: [helperId], references: [id], onDelete: Cascade)

  helpRequestId String
  request       HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)

  message String
  amount  Float?

  status BidStatus @default(PENDING)

  createdAt DateTime @default(now())
}

model Message {
  id             String @id @default(uuid())
  conversationId String
  senderId       String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       UserModel    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  content   String?
  type      MessageType @default(TEXT)
  isRead    Boolean     @default(false)
  editedAt  DateTime?
  deletedAt DateTime?

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  content String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
}

model Review {
  id         String  @id @default(cuid())
  rating     Int
  title      String?
  comment    String
  isApproved Boolean @default(true)

  likesCount Int @default(0)
  replyCount Int @default(0)

  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  replies ReviewReply[]
  likes   ReviewLike[]
  images  Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targetUserId String
  targetUser   UserModel @relation("UserReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, title, comment])
  @@index([userId])
  @@index([createdAt])
}

model ReviewReply {
  id      String @id @default(cuid())
  comment String

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId String

  likes      ReviewLike[]
  likesCount Int          @default(0)

  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([userId])
}

model ReviewLike {
  id String @id @default(cuid())

  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reviewReplyId String?
  reviewReply   ReviewReply? @relation(fields: [reviewReplyId], references: [id], onDelete: Cascade)

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@unique([userId, reviewReplyId])
  @@index([reviewId])
  @@index([reviewReplyId])
  @@index([userId])
}

model Favorite {
  id     String @id @default(uuid())
  userId String

  createdAt DateTime @default(now())

  user UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("favorites")
}

model Image {
  id       String    @id @default(uuid())
  url      String
  publicId String?
  type     ImageType

  userId    String?
  reviewId  String?
  requestId String?
  messageId String?

  review  Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user    UserModel?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  request HelpRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  message Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([reviewId])
  @@index([requestId])
  @@index([messageId])
  @@index([type])
  @@map("images")
}

enum AuthProvider {
  GOOGLE
}

enum UserType {
  GENERAL
  ELDERLY
  DISABLED
}

enum RequestStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MessageType {
  TEXT
  IMAGE
  TEXT_IMAGE
  SYSTEM
}

enum ImageType {
  REVIEW
  REQUEST
  MESSAGE
}
