generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================
// MODELS
// ======================

model UserModel {
  id           String  @id @default(uuid())
  email        String  @unique
  phone        String  @unique
  passwordHash String
  isVerified   Boolean @default(false)

  profile Profile?

  requests HelpRequest[] @relation("UserRequests")
  bids     Bid[]         @relation("UserBids")

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  receivedReviews Review[] @relation("UserReviewsReceived")

  notifications Notification[]
  refreshTokens RefreshToken[]

  reviews       Review[]
  reviewReplies ReviewReply[]
  reviewLikes   ReviewLike[]
  favorites     Favorite[]
  images        Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  bio         String?
  dateOfBirth DateTime?
  gender      Gender?
  userType    UserType  @default(GENERAL)
  rating      Float     @default(0)
  helpCount   Int       @default(0)

  // Optional: user-preferred nearby search radius
  searchRadiusMeters Int? @default(800)

  user      UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressId String?   @unique
  address   Location? @relation("ProfileAddress", fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id               String   @id @default(uuid())
  latitude         Float
  longitude        Float

  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  formattedAddress String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  helpRequest HelpRequest? @relation("HelpRequestLocation")
  profile     Profile?     @relation("ProfileAddress")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  createdAt DateTime @default(now())
  expiresAt DateTime
}

model HelpRequest {
  id          String    @id @default(uuid())
  requesterId String
  requester   UserModel @relation("UserRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  title       String
  description String
  category    String

  locationId String?   @unique
  location   Location? @relation("HelpRequestLocation", fields: [locationId], references: [id], onDelete: SetNull)

  // Optional: request-specific radius
  serviceRadiusMeters Int? @default(800)

  budget Float?
  isPaid Boolean       @default(false)
  status RequestStatus @default(OPEN)

  bids     Bid[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bid {
  id String @id @default(uuid())

  helperId String
  helper   UserModel @relation("UserBids", fields: [helperId], references: [id], onDelete: Cascade)

  helpRequestId String
  request       HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)

  message String
  amount  Float?

  status BidStatus @default(PENDING)

  createdAt DateTime @default(now())
}

model Message {
  id String @id @default(uuid())

  senderId String
  sender   UserModel @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   UserModel @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  requestId String
  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  content String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  content String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
}

model Review {
  id         String  @id @default(cuid())
  rating     Int
  title      String?
  comment    String
  isApproved Boolean @default(true)

  likesCount Int @default(0)
  replyCount Int @default(0)

  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  replies ReviewReply[]
  likes   ReviewLike[]
  images  Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targetUserId String
  targetUser   UserModel @relation("UserReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, title, comment])
  @@index([userId])
  @@index([createdAt])
}

model ReviewReply {
  id      String @id @default(cuid())
  comment String

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId String

  likes      ReviewLike[]
  likesCount Int          @default(0)

  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([userId])
}

model ReviewLike {
  id String @id @default(cuid())

  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reviewReplyId String?
  reviewReply   ReviewReply? @relation(fields: [reviewReplyId], references: [id], onDelete: Cascade)

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@unique([userId, reviewReplyId])
  @@index([reviewId])
  @@index([reviewReplyId])
  @@index([userId])
}

model Favorite {
  id     String @id @default(uuid())
  userId String

  createdAt DateTime @default(now())

  user UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("favorites")
}

model Image {
  id       String  @id @default(uuid())
  url      String
  publicId String?

  userId   String?
  reviewId String?

  review Review?    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   UserModel? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([reviewId])
}

// ======================
// ENUMS
// ======================

enum UserType {
  GENERAL
  ELDERLY
  DISABLED
}

enum RequestStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}