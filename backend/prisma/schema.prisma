generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserModel {
  id           String  @id @default(uuid())
  email        String  @unique
  phone        String? @unique
  passwordHash String?
  isVerified   Boolean @default(false)

  profile Profile?

  requests         HelpRequest[] @relation("UserRequests")
  bids             Bid[]         @relation("UserBids")
  assignedRequests HelpRequest[] @relation("AssignedRequests")

  sentMessages  Message[]            @relation("SentMessages")
  conversations ConversationMember[]

  receivedReviews Review[] @relation("UserReviewsReceived")

  notificationsReceived Notification[] @relation("UserNotifications")
  notificationsActed    Notification[] @relation("ActorNotifications")

  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  pushTokens    PushToken[]

  reviews       Review[]
  reviewReplies ReviewReply[]
  reviewLikes   ReviewLike[]
  favorites     Favorite[]
  images        Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model DeletedAccount {
  id        String   @id @default(uuid())
  email     String   @unique
  deletedAt DateTime @default(now())

  @@map("deleted_accounts")
}

model OAuthAccount {
  id         String       @id @default(uuid())
  provider   AuthProvider
  providerId String

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  bio         String?
  dateOfBirth DateTime?
  gender      Gender?
  userType    UserType  @default(GENERAL)
  rating      Float     @default(0)
  helpCount   Int       @default(0)

  avatarUrl      String?
  avatarPublicId String?

  searchRadiusMeters Int? @default(800)

  user      UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressId String?   @unique
  address   Location? @relation("ProfileAddress", fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@map("profiles")
}

model Location {
  id               String   @id @default(uuid())
  latitude         Float
  longitude        Float
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  formattedAddress String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  helpRequest HelpRequest? @relation("HelpRequestLocation")
  profile     Profile?     @relation("ProfileAddress")

  @@index([city])
  @@index([country])
  @@map("locations")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PushToken {
  id       String    @id @default(uuid())
  userId   String
  user     UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  token    String    @unique
  platform String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([platform])
  @@map("push_tokens")
}

model HelpRequest {
  id          String    @id @default(uuid())
  requesterId String
  requester   UserModel @relation("UserRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  title       String
  description String
  category    String

  locationId String?   @unique
  location   Location? @relation("HelpRequestLocation", fields: [locationId], references: [id], onDelete: SetNull)

  serviceRadiusMeters Int? @default(800)

  budget Float?
  isPaid Boolean       @default(false)
  status RequestStatus @default(OPEN)

  bids             Bid[]
  assignedHelperId String?
  assignedHelper   UserModel? @relation("AssignedRequests", fields: [assignedHelperId], references: [id], onDelete: SetNull)

  conversation  Conversation?
  images        Image[]
  notifications Notification[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  favorites Favorite[]

  @@index([requesterId])
  @@index([assignedHelperId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("help_requests")
}

model Conversation {
  id        String      @id @default(uuid())
  requestId String      @unique
  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  members       ConversationMember[]
  messages      Message[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("conversations")
}

model ConversationMember {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         UserModel    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_members")
}

model Bid {
  id String @id @default(uuid())

  helperId String
  helper   UserModel @relation("UserBids", fields: [helperId], references: [id], onDelete: Cascade)

  helpRequestId String
  request       HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)

  message String
  amount  Float?

  status BidStatus @default(PENDING)

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([helperId])
  @@index([helpRequestId])
  @@index([status])
  @@index([createdAt])
  @@map("bids")
}

model Message {
  id             String @id @default(uuid())
  conversationId String
  senderId       String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       UserModel    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  content   String?
  type      MessageType @default(TEXT)
  isRead    Boolean     @default(false)
  editedAt  DateTime?
  deletedAt DateTime?

  images        Image[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isRead])
  @@map("messages")
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   UserModel @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  actorId String?
  actor   UserModel? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  type  NotificationType
  title String
  body  String

  requestId String?
  request   HelpRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  bidId String?
  bid   Bid?    @relation(fields: [bidId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  data Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([actorId])
  @@index([type])
  @@index([requestId])
  @@index([bidId])
  @@index([conversationId])
  @@index([messageId])
  @@index([reviewId])
  @@map("notifications")
}

model Review {
  id         String  @id @default(cuid())
  rating     Int
  title      String?
  comment    String
  isApproved Boolean @default(true)

  likesCount Int @default(0)
  replyCount Int @default(0)

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   UserModel @relation("UserReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  replies       ReviewReply[]
  likes         ReviewLike[]
  images        Image[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, title, comment])
  @@index([userId])
  @@index([targetUserId])
  @@index([createdAt])
  @@index([isApproved])
  @@map("reviews")
}

model ReviewReply {
  id      String @id @default(cuid())
  comment String

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  likes      ReviewLike[]
  likesCount Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
  @@index([userId])
  @@index([createdAt])
  @@map("review_replies")
}

model ReviewLike {
  id String @id @default(cuid())

  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reviewReplyId String?
  reviewReply   ReviewReply? @relation(fields: [reviewReplyId], references: [id], onDelete: Cascade)

  userId String
  user   UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@unique([userId, reviewReplyId])
  @@index([reviewId])
  @@index([reviewReplyId])
  @@index([userId])
  @@map("review_likes")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  requestId String
  createdAt DateTime @default(now())

  user    UserModel   @relation(fields: [userId], references: [id], onDelete: Cascade)
  request HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([requestId])
  @@map("favorites")
}

model Image {
  id       String    @id @default(uuid())
  url      String
  publicId String?
  type     ImageType

  userId    String?
  reviewId  String?
  requestId String?
  messageId String?

  review  Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user    UserModel?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  request HelpRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  message Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([reviewId])
  @@index([requestId])
  @@index([messageId])
  @@index([type])
  @@map("images")
}

enum AuthProvider {
  GOOGLE
}

enum UserType {
  GENERAL
  ELDERLY
  DISABLED
}

enum RequestStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MessageType {
  TEXT
  IMAGE
  TEXT_IMAGE
  SYSTEM
}

enum ImageType {
  REVIEW
  REQUEST
  MESSAGE
}

enum NotificationType {
  BID_RECEIVED
  BID_ACCEPTED
  BID_REJECTED
  REQUEST_ASSIGNED
  REQUEST_COMPLETED
  REQUEST_CANCELLED
  MESSAGE_RECEIVED
  REVIEW_RECEIVED
  REVIEW_REPLY_RECEIVED
  SYSTEM
}
