# ============================================================
# community-help-platform — Backend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to source control.
# ============================================================

# ─── Server ──────────────────────────────────────────────────
PORT=5001
HOST=0.0.0.0
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/community_help_platform

# ─── JWT Secrets ─────────────────────────────────────────────
# Required in production; dev fallbacks are used if absent.
# Use long, random strings (e.g. openssl rand -hex 64).
JWT_SECRET=replace_with_a_long_random_access_token_secret
REFRESH_SECRET=replace_with_a_long_random_refresh_token_secret

# ─── Token TTLs (optional — defaults shown) ──────────────────
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
# PHONE_VERIFICATION_CODE_TTL_MINUTES=10

# ─── Redis ───────────────────────────────────────────────────
# Required in production for rate limiting and session monitoring.
# Optional in development (server starts in degraded mode if absent).
# Must use redis:// or rediss:// (not an Upstash REST https:// URL).
REDIS_URL=redis://localhost:6379
# Set to "true" to abort startup if Redis is unreachable.
# STRICT_REDIS_STARTUP=false

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production.
# Leave empty in development to use the default localhost list.
# CORS_ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com

# ─── Cloudinary (image storage) ──────────────────────────────
# Required for avatar upload, request images, and certifications.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email ───────────────────────────────────────────────────
# EMAIL_DELIVERY_MODE options:
#   log         — print email content to console (development default)
#   nodemailer  — send via SMTP
EMAIL_DELIVERY_MODE=log

# Required when EMAIL_DELIVERY_MODE=nodemailer
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USER=postmaster@mg.example.com
# EMAIL_PASS=your_smtp_password_or_api_key
# EMAIL_FROM=no-reply@example.com

# ─── Email link base URLs ────────────────────────────────────
# Base URL used for deep links in password-reset / email-verify emails.
# Defaults to the deep link scheme "communityhelp://"
# MOBILE_DEEP_LINK_BASE_URL=communityhelp://
# PUBLIC_APP_URL=https://myapp.com

# ─── SMS / Phone Verification ────────────────────────────────
# SMS_DELIVERY_MODE options:
#   log           — print OTP to console (development default)
#   twilio        — app generates OTP, sends via Twilio Programmable SMS
#   twilio-verify — Twilio Verify generates and validates the OTP (recommended for production)
SMS_DELIVERY_MODE=log

# Required when SMS_DELIVERY_MODE=twilio or twilio-verify
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Required only when SMS_DELIVERY_MODE=twilio
# TWILIO_PHONE_NUMBER=+15551234567

# Required only when SMS_DELIVERY_MODE=twilio-verify
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend cooldown in seconds (applies to twilio-verify mode)
# PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ─── Google OAuth ─────────────────────────────────────────────
# At least one client ID is required to enable Google Sign-In.
# GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID_WEB=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID_IOS=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_ID_ANDROID=xxx.apps.googleusercontent.com

# ─── Development helpers ─────────────────────────────────────
# Allow fake/dev Google ID tokens in development (never enable in production).
# ALLOW_DEV_OAUTH=false
