# ============================================================
# community-help-platform — Mobile App Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to source control.
#
# All variables exposed to the app bundle MUST be prefixed
# with EXPO_PUBLIC_ (Expo SDK 49+ convention).
# ============================================================

# ─── API Base URL ────────────────────────────────────────────
# The base URL of the backend REST API.
#
# • Leave unset (or set to a localhost URL) in local development:
#   the app auto-detects the Expo dev-server host and appends :5001/api.
#   Note: localhost URLs are ignored on physical Android/iOS devices.
#
# • Set to your deployed backend for production / EAS builds:
EXPO_PUBLIC_API_BASE_URL=https://community-help-platform.onrender.com/api

# ─── Google Maps ─────────────────────────────────────────────
# Required for the map and nearby-requests features.
# Create a key at https://console.cloud.google.com and restrict it
# to Maps SDK for Android / Maps SDK for iOS.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_api_key
